# Copy to .env and adjust. Every setting is optional; the defaults below are what
# Mendwork uses when the variable is unset. .env is never committed.

# development | test | production
# production renders logs as JSON; anything else renders them for humans.
MENDWORK_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
MENDWORK_LOG_LEVEL=INFO

# Log field names whose values are replaced with [REDACTED]. Matching is
# case-insensitive and by substring. JSON array; overrides the default set.
# MENDWORK_SENSITIVE_KEY_FRAGMENTS=["password","secret","token"]

# Where `make portal` serves the chaos portal. Keep the host on loopback: the portal
# is a local test target. Port 0 picks any free port.
MENDWORK_PORTAL_HOST=127.0.0.1
MENDWORK_PORTAL_PORT=8765

# Largest workflow file, in bytes, that validate and the workflow store will read
# (4096 to 16777216). Checked before parsing.
MENDWORK_WORKFLOW_MAX_BYTES=1048576

# Replay timing, in milliseconds. Waits are explicit conditions bounded by these, never sleeps.
# Settle, Rung 0 resolution, pre-action waits, and the action itself.
MENDWORK_STEP_TIMEOUT_MS=10000
# A waiting checkpoint without its own timeout_ms.
MENDWORK_CHECKPOINT_TIMEOUT_MS=10000
# One attempt of a navigate step.
MENDWORK_NAVIGATION_TIMEOUT_MS=30000
# The whole run.
MENDWORK_RUN_TIMEOUT_MS=600000
# How long to wait for a quiet DOM before reading a busy page anyway, and how many quiet
# animation frames count as settled.
MENDWORK_SETTLE_TIMEOUT_MS=2000
MENDWORK_SETTLE_QUIET_FRAMES=2

# Transient navigation retries (timeouts, dropped connections, HTTP 502/503/504 only).
MENDWORK_NAVIGATION_MAX_ATTEMPTS=3
MENDWORK_RETRY_INITIAL_DELAY_MS=500
MENDWORK_RETRY_MAX_DELAY_MS=4000
MENDWORK_RETRY_BACKOFF_MULTIPLIER=2.0
MENDWORK_RETRY_JITTER_RATIO=0.5

# Egress policy (ARCHITECTURE.md §8, ADR 0011). JSON arrays. Host names a run may navigate to at
# the top level: exact names, or *.example.com for any subdomain. Empty (the default) allows no
# navigation at all, so a site is automated only once it is named here.
# MENDWORK_EGRESS_ALLOWED_DOMAINS=["portal.example.com","*.example.com"]
# Exact loopback ip:port origins exempt from the address rules, for local test targets such as the
# chaos portal. Only literal loopback addresses with a port; refused when MENDWORK_ENVIRONMENT is
# production.
# MENDWORK_EGRESS_LOOPBACK_EXCEPTIONS=["127.0.0.1:8765"]

# Browser and evidence. Approval decisions are appended to <artifacts>/audit/audit.jsonl.
MENDWORK_ARTIFACTS_DIR=artifacts
MENDWORK_BROWSER_HEADLESS=true
MENDWORK_BROWSER_SLOW_MO_MS=0
MENDWORK_VIEWPORT_WIDTH=1280
MENDWORK_VIEWPORT_HEIGHT=720
MENDWORK_TRACE_ON_FAILURE=true

# Recording (`mendwork record`). How long a proposed checkpoint may wait while it is verified
# at record time; the page has already settled and been observed, so this stays short.
MENDWORK_RECORD_CHECKPOINT_TIMEOUT_MS=1000
# How many ancestors of an ambiguous target are tried as a selector scope (1-20).
MENDWORK_RECORD_SCOPE_ANCESTORS_MAX=6
# How many visible headings and landmarks are read before and after each recorded step.
MENDWORK_RECORD_LANDMARKS_MAX=40

# Risk classification by consequence (ARCHITECTURE.md §8). JSON arrays of lower-case words;
# each replaces its default set. Soft verbs must also be danger words, and view-state nouns
# must also be read words. Unknown actions are CAUTION.
# MENDWORK_RISK_DANGER_WORDS=["delete","remove","pay","purchase","submit","send","confirm","transfer","save"]
# MENDWORK_RISK_SOFT_VERBS=["remove","reset"]
# MENDWORK_RISK_VIEW_STATE_NOUNS=["filter","filters","sort","search"]
# MENDWORK_RISK_READ_WORDS=["view","open","download","export","filter","filters","sort","search"]
# MENDWORK_RISK_SESSION_PHRASES=["sign in","sign out","log in","log out","login","logout"]

# Healing (ARCHITECTURE.md §7, ADR 0009). Rung 2 feature weights sum to 1. Settings refuses
# weights that would let role, tag/type, nearby text, structural path, and position alone reach
# the accept threshold, or a margin not larger than each nearby-text, path, and position weight.
MENDWORK_HEAL_WEIGHT_NAME=0.25
MENDWORK_HEAL_WEIGHT_LABEL=0.05
MENDWORK_HEAL_WEIGHT_ATTRIBUTES=0.25
MENDWORK_HEAL_WEIGHT_ROLE=0.10
MENDWORK_HEAL_WEIGHT_TAG_TYPE=0.05
MENDWORK_HEAL_WEIGHT_NEARBY_TEXT=0.10
MENDWORK_HEAL_WEIGHT_STRUCTURAL_PATH=0.10
MENDWORK_HEAL_WEIGHT_POSITION=0.10
# Accept a heal only when the best candidate scores at least the threshold and leads the next
# by at least the margin.
MENDWORK_HEAL_ACCEPT_THRESHOLD=0.60
MENDWORK_HEAL_ACCEPT_MARGIN=0.15
MENDWORK_HEAL_NAME_SIMILARITY_FLOOR=0.5
MENDWORK_HEAL_POSITION_SCALE=0.25
# Pages with more action-compatible visible elements than this are never healed: a capability
# limit. The heaviest page measured for ADR 0009 (a large Wikipedia table) has 1,769.
MENDWORK_HEAL_CANDIDATES_MAX=4000
MENDWORK_HEAL_MAX_ATTEMPTS=2
# 0 or 1: heal attempts for steps that sign in or type a credential.
MENDWORK_HEAL_AUTHENTICATION_MAX_ATTEMPTS=1
MENDWORK_HEAL_REPORT_CANDIDATES=5
MENDWORK_HEAL_TIMEOUT_MS=30000

# Rung 3: a model chooses among the candidates Rung 2 could not decide between (ADR 0010).
# No model is configured by default. none | ollama | gemini | openai_compatible
MENDWORK_MODEL_PROVIDER=none
# The provider's own name for the model, such as an Ollama tag. Required with a provider.
# MENDWORK_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
# Defaults: ollama http://127.0.0.1:11434, gemini https://generativelanguage.googleapis.com/v1beta.
# Required for openai_compatible.
# MENDWORK_MODEL_BASE_URL=
# Required for gemini; optional for openai_compatible. Keep it out of committed files.
# MENDWORK_MODEL_API_KEY=
# One call, retries included (capped by the heal deadline), and how many eligible candidates a
# model is shown. Measured on an 8 GB M2 with a 4B Ollama model: cold calls up to 22.6 s (ADR 0010).
MENDWORK_MODEL_TIMEOUT_MS=30000
MENDWORK_MODEL_CANDIDATES_K=5
MENDWORK_MODEL_MAX_ATTEMPTS=3
MENDWORK_MODEL_RETRY_INITIAL_DELAY_MS=500
MENDWORK_MODEL_RETRY_MAX_DELAY_MS=4000
MENDWORK_MODEL_BREAKER_FAILURES=3
MENDWORK_MODEL_BREAKER_RESET_MS=60000
# Budgets: calls per run, and per workspace per UTC day (counted in <artifacts>/usage).
MENDWORK_MODEL_MAX_CALLS_PER_RUN=4
MENDWORK_MODEL_MAX_CALLS_PER_DAY=200
# Hosted models' USD prices per million tokens; a model missing here is recorded as unpriced.
# MENDWORK_MODEL_PRICES={"model-name": {"input_usd_per_million_tokens": "0.10", "output_usd_per_million_tokens": "0.40"}}
# For openai_compatible: true when the server runs on this machine, so calls cost nothing.
MENDWORK_MODEL_LOCAL=false
MENDWORK_MODEL_TEMPERATURE=0.0
MENDWORK_MODEL_SEED=0
MENDWORK_MODEL_MAX_OUTPUT_TOKENS=200
# Ollama only: context window and how long the model stays loaded after a call.
MENDWORK_MODEL_CONTEXT_TOKENS=4096
MENDWORK_MODEL_KEEP_ALIVE=5m
# true or false for a thinking model; leave unset for models without a thinking mode.
# MENDWORK_MODEL_THINK=false
MENDWORK_MODEL_MAX_RESPONSE_BYTES=65536

# Patching (ARCHITECTURE.md §9, ADR 0013). Where workflow versions and pending patches are stored:
# <dir>/<workflow_id>/v0001.yaml and <dir>/.pending/. A file given to `mendwork run` is matched to
# its stored versions by content and never written; `mendwork import` makes a file the latest.
MENDWORK_WORKFLOW_STORE_DIR=workflow-store
# immediate: a verified heal from a succeeded run becomes a version at once. after_n_successes: it
# is tried first on later runs, and becomes a version once this many succeeded runs verified it
# (2-100).
MENDWORK_PATCH_PROMOTION=immediate
MENDWORK_PATCH_PROMOTION_SUCCESSES=3
# How many times a heal is placed on the latest version again when another process published
# first (1-20).
MENDWORK_PATCH_PUBLISH_ATTEMPTS=5
# PNG bytes a run report embeds, most telling screenshots first (0-268435456); a screenshot past
# the budget is named in the report instead of shown.
MENDWORK_REPORT_SCREENSHOTS_MAX_BYTES=8388608

# Secrets are never set here: Settings refuses MENDWORK_SECRET_* in .env. Export them in the
# process environment instead, named after the workflow's secret in UPPER_SNAKE_CASE:
#   export MENDWORK_SECRET_PORTAL_PASSWORD=...
