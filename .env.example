# Copy to .env and adjust. Every setting is optional; the defaults below are what
# Mendwork uses when the variable is unset. .env is never committed.

# development | test | production
# production renders logs as JSON; anything else renders them for humans.
MENDWORK_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
MENDWORK_LOG_LEVEL=INFO

# Log field names whose values are replaced with [REDACTED]. Matching is
# case-insensitive and by substring. JSON array; overrides the default set.
# MENDWORK_SENSITIVE_KEY_FRAGMENTS=["password","secret","token"]

# Where `make portal` serves the chaos portal. Keep the host on loopback: the portal
# is a local test target. Port 0 picks any free port.
MENDWORK_PORTAL_HOST=127.0.0.1
MENDWORK_PORTAL_PORT=8765

# Largest workflow file, in bytes, that validate and the workflow store will read
# (4096 to 16777216). Checked before parsing.
MENDWORK_WORKFLOW_MAX_BYTES=1048576

# Replay timing, in milliseconds. Waits are explicit conditions bounded by these, never sleeps.
# Settle, Rung 0 resolution, pre-action waits, and the action itself.
MENDWORK_STEP_TIMEOUT_MS=10000
# A waiting checkpoint without its own timeout_ms.
MENDWORK_CHECKPOINT_TIMEOUT_MS=10000
# One attempt of a navigate step.
MENDWORK_NAVIGATION_TIMEOUT_MS=30000
# The whole run.
MENDWORK_RUN_TIMEOUT_MS=600000
# How long to wait for a quiet DOM before reading a busy page anyway, and how many quiet
# animation frames count as settled.
MENDWORK_SETTLE_TIMEOUT_MS=2000
MENDWORK_SETTLE_QUIET_FRAMES=2

# Transient navigation retries (timeouts, dropped connections, HTTP 502/503/504 only).
MENDWORK_NAVIGATION_MAX_ATTEMPTS=3
MENDWORK_RETRY_INITIAL_DELAY_MS=500
MENDWORK_RETRY_MAX_DELAY_MS=4000
MENDWORK_RETRY_BACKOFF_MULTIPLIER=2.0
MENDWORK_RETRY_JITTER_RATIO=0.5

# Browser and evidence.
MENDWORK_ARTIFACTS_DIR=artifacts
MENDWORK_BROWSER_HEADLESS=true
MENDWORK_BROWSER_SLOW_MO_MS=0
MENDWORK_VIEWPORT_WIDTH=1280
MENDWORK_VIEWPORT_HEIGHT=720
MENDWORK_TRACE_ON_FAILURE=true

# Recording (`mendwork record`). How long a proposed checkpoint may wait while it is verified
# at record time; the page has already settled and been observed, so this stays short.
MENDWORK_RECORD_CHECKPOINT_TIMEOUT_MS=1000
# How many ancestors of an ambiguous target are tried as a selector scope (1-20).
MENDWORK_RECORD_SCOPE_ANCESTORS_MAX=6
# How many visible headings and landmarks are read before and after each recorded step.
MENDWORK_RECORD_LANDMARKS_MAX=40

# Risk classification by consequence (ARCHITECTURE.md §8). JSON arrays of lower-case words;
# each replaces its default set. Soft verbs must also be danger words, and view-state nouns
# must also be read words. Unknown actions are CAUTION.
# MENDWORK_RISK_DANGER_WORDS=["delete","remove","pay","purchase","submit","send","confirm","transfer","save"]
# MENDWORK_RISK_SOFT_VERBS=["remove","reset"]
# MENDWORK_RISK_VIEW_STATE_NOUNS=["filter","filters","sort","search"]
# MENDWORK_RISK_READ_WORDS=["view","open","download","export","filter","filters","sort","search"]
# MENDWORK_RISK_SESSION_PHRASES=["sign in","sign out","log in","log out","login","logout"]

# Secrets are never set here: Settings refuses MENDWORK_SECRET_* in .env. Export them in the
# process environment instead, named after the workflow's secret in UPPER_SNAKE_CASE:
#   export MENDWORK_SECRET_PORTAL_PASSWORD=...
